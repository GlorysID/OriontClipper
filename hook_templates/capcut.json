{
  "name": "CapCut Modern",
  "hook": {
    "font_name": "Impact",
    "font_size": 82,
    "font_color": "#ffffff",
    "highlight_color": "#00ff66",
    "highlight_last_word": true,
    "border_w": 2,
    "border_color": "#000000@0.90",
    "shadow_x": 3,
    "shadow_y": 3,
    "shadow_color": "#000000@0.60",
    "box": true,
    "box_color": "#141824@0.80",
    "box_border_w": 24,
    "box_radius": 24,
    "box_outline_w": 2,
    "box_outline_color": "#00ff66@0.70",
    "x": "(w-text_w)/2",
    "y": "upper_center",
    "letter_spacing": 0,
    "rotate": 0
  },
  "subtitle": {
    "font_name": "Impact",
    "mode": "karaoke",
    "text_transform": "upper",
    "font_size": 74,
    "font_color": "#ffffff",
    "highlight_color": "#00ff66",
    "outline_color": "#000000",
