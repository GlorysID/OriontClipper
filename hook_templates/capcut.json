    "margin_v": 420,
    "words_per_phrase": 4,
    "max_line_chars": 26
  },
  "video": {
    "background_blur": 25,
    "background_blur_power": 5,
    "overlay_enabled": true,
    "width": 1080,
    "x": "(W-w)/2",
    "y": "(H-h)/2",
    "border_w": 0,
    "border_color": "#ffffff@0.70"
