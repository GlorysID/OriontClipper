# 9Router local OpenAI-compatible endpoint.
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Leave empty if local 9Router does not require Authorization.
NINEROUTER_API_KEY=

# Alias/combo configured in the 9Router dashboard, not a provider model name.
NINEROUTER_MODEL=auto
REQUEST_TIMEOUT_S=120
MAX_RETRIES=3
RETRY_BACKOFF_S=5
AI_TRANSCRIPT_CHUNK_CHARS=12000
AI_MAX_TRANSCRIPT_CHUNKS=12

# faster-whisper config. Uses int8 quantization for CPU speed.
# Model: tiny (151MB), base (290MB), small (483MB), medium (1.5GB), large-v3 (2.9GB), large-v3-turbo (1.2GB)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8       # int8 (fast, low mem) or float16 (more accurate)
WHISPER_LANGUAGE=               # biarkan kosong untuk auto-detect, isi "id" untuk Indonesia
WHISPER_BEAM_SIZE=3             # 1=cepat, 3=seimbang, 5=lebih akurat (lebih lambat)
WHISPER_VAD_FILTER=1            # 1=filter segmen non-speech, 0=transkripsi semua

# Conservative FFmpeg defaults.
FFMPEG_THREADS=2
USE_IONICE=1

# Optional path overrides. Relative paths are resolved from the project root.
INPUT_DIR=input
OUTPUT_DIR=output
PROCESSED_DIR=processed
FAILED_DIR=failed
TMP_DIR=tmp
TRANSCRIPT_CACHE_DIR=tmp/transcripts
LOG_DIR=logs
HOOK_TEMPLATE_PATH=hook_templates/capcut.json
HOOK_EDITOR_TOKEN=change-me-long-random-token

# Rendering defaults.
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
MAX_CLIPS=3
MAX_CLIP_DURATION_S=120
HOOK_BADGE_TEXT=HOT TAKE
HOOK_DISPLAY_SECONDS=3
HOOK_FADE_SECONDS=0.35
HOOK_MAX_LINE_CHARS=20
HOOK_MAX_LINES=3
SUBTITLE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# File stability check before queue processing.
FILE_STABILITY_INTERVAL_S=3
FILE_STABILITY_CHECKS=2

# Telegram Bot (opsional — kosongkan jika tidak pakai bot).
TELEGRAM_BOT_TOKEN=
# Daftar user ID yang diizinkan, pisahkan dengan koma. Kosongkan untuk izinkan semua.
TELEGRAM_ALLOWED_USERS=
